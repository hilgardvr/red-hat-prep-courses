#!/usr/bin/env bash
#
# RHCSA Field Guide — lab control
#
# Usage:
#   ./bin/lab doctor
#   ./bin/lab up
#   ./bin/lab status
#   ./bin/lab ssh [server|node2]
#   ./bin/lab snapshot [name]
#   ./bin/lab restore [name]
#   ./bin/lab check <module> [lab1|lab2|challenge|all]
#   ./bin/lab halt
#   ./bin/lab reset
#   ./bin/lab destroy

set -euo pipefail

LAB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
KEYS_DIR="$LAB_DIR/keys"
KEY="$KEYS_DIR/lab_ed25519"

info() { printf '==> %s\n' "$*"; }
warn() { printf 'WARN  %s\n' "$*" >&2; }
die()  { printf 'ERROR %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
RHCSA lab control

  ./bin/lab doctor                 Check the host and dependencies
  ./bin/lab up                     Create or start both VMs
  ./bin/lab status                 Show VM status
  ./bin/lab ssh [server|node2]     Log in (default: server)
  ./bin/lab snapshot [name]        Snapshot both VMs (default: clean)
  ./bin/lab restore [name]         Restore both VMs (default: clean)
  ./bin/lab check <module> [lab]   Run a lab checker (default lab: all)
  ./bin/lab halt                   Shut down both VMs
  ./bin/lab reset                  Destroy and rebuild both VMs
  ./bin/lab destroy                Delete both VMs

Environment:
  LAB_KEY_PATH   Lab SSH key location (default: labs/keys/lab_ed25519)
EOF
}

ensure_key() {
  mkdir -p "$KEYS_DIR"
  if [ ! -f "$KEY" ]; then
    info "Generating lab SSH key: $KEY"
    ssh-keygen -t ed25519 -N "" -C "rhcsa-lab" -f "$KEY" >/dev/null
  fi
  chmod 600 "$KEY"
  chmod 644 "$KEY.pub"
}

prepare() {
  ensure_key
  export LAB_KEY_PATH="$KEY"
}

vagrant_cmd() {
  ( cd "$LAB_DIR" && vagrant "$@" )
}

cmd_doctor() {
  local failures=0

  hr() { printf '\n%s\n' "$*"; }

  check_cmd() {
    if command -v "$1" >/dev/null 2>&1; then
      printf '  ok    %s\n' "$1"
    else
      printf '  MISS  %s\n' "$1"
      failures=$((failures + 1))
    fi
  }

  hr "Commands"
  check_cmd vagrant
  check_cmd virsh
  check_cmd ssh-keygen

  if command -v qemu-system-x86_64 >/dev/null 2>&1 || command -v qemu-kvm >/dev/null 2>&1; then
    printf '  ok    qemu\n'
  else
    printf '  MISS  qemu (install qemu-kvm)\n'
    failures=$((failures + 1))
  fi

  hr "Vagrant provider"
  if vagrant plugin list 2>/dev/null | grep -q '^vagrant-libvirt'; then
    printf '  ok    vagrant-libvirt\n'
  else
    printf '  MISS  vagrant-libvirt (run: vagrant plugin install vagrant-libvirt)\n'
    failures=$((failures + 1))
  fi

  hr "Virtualization"
  if [ -e /dev/kvm ]; then
    if [ -r /dev/kvm ] && [ -w /dev/kvm ]; then
      printf '  ok    /dev/kvm is accessible\n'
    else
      printf '  MISS  /dev/kvm is not accessible (add your user to the kvm group)\n'
      failures=$((failures + 1))
    fi
  else
    printf '  MISS  /dev/kvm not found (enable virtualization in firmware)\n'
    failures=$((failures + 1))
  fi

  if virsh --connect qemu:///system list >/dev/null 2>&1; then
    printf '  ok    libvirt connection works\n'
  else
    printf '  MISS  cannot connect to qemu:///system (libvirtd running? libvirt group?)\n'
    failures=$((failures + 1))
  fi

  hr "Resources"
  local mem_gb disk_gb disk_path
  mem_gb=$(awk '/MemTotal/ {printf "%.1f", $2/1024/1024}' /proc/meminfo)
  disk_path="/var/lib/libvirt/images"
  [ -d "$disk_path" ] || disk_path="$LAB_DIR"
  disk_gb=$(df -Pk "$disk_path" | awk 'NR==2 {printf "%.1f", $4/1024/1024}')
  printf '  info  RAM: %s GB\n' "$mem_gb"
  printf '  info  free disk under %s: %s GB\n' "$disk_path" "$disk_gb"

  if awk -v m="$mem_gb" 'BEGIN {exit !(m < 10)}'; then
    printf '  MISS  less than 10 GB RAM; the two VMs will not run reliably\n'
    failures=$((failures + 1))
  elif awk -v m="$mem_gb" 'BEGIN {exit !(m < 16)}'; then
    printf '  WARN  less than 16 GB RAM; reduce VM memory in the Vagrantfile if needed\n'
  fi

  if awk -v d="$disk_gb" 'BEGIN {exit !(d < 30)}'; then
    printf '  MISS  less than 30 GB free disk\n'
    failures=$((failures + 1))
  fi

  hr "Lab configuration"
  if [ -f "$KEY" ]; then
    printf '  ok    lab SSH key: %s\n' "$KEY"
  else
    printf '  info  lab SSH key will be generated by ./bin/lab up\n'
  fi

  hr "Result"
  if [ "$failures" -eq 0 ]; then
    printf '  Ready. Run ./bin/lab up\n'
  else
    printf '  %d issue(s) to fix. See the hints above.\n' "$failures"
    return 1
  fi
}

cmd_up() {
  prepare
  info "Starting the lab (box: almalinux/10)"
  vagrant_cmd up
  cat <<'EOF'

Lab is ready.

  server  10.10.10.10  (vagrant / labuser)
  node2   10.10.10.11  (vagrant / labuser)

Log in:      ./bin/lab ssh
Snapshot:    ./bin/lab snapshot clean
Run a check: ./bin/lab check r01 lab1

Lab user password: labpass
EOF
}

cmd_status() {
  prepare
  vagrant_cmd status
}

cmd_ssh() {
  prepare
  vagrant_cmd ssh "${1:-server}"
}

cmd_snapshot() {
  prepare
  local name="${1:-clean}"
  local machine
  for machine in server node2; do
    info "Snapshotting $machine as '$name'"
    vagrant_cmd snapshot delete "$machine" "$name" >/dev/null 2>&1 || true
    vagrant_cmd snapshot save "$machine" "$name"
  done
}

cmd_restore() {
  prepare
  local name="${1:-clean}"
  local machine
  for machine in server node2; do
    info "Restoring $machine from '$name'"
    vagrant_cmd snapshot restore "$machine" "$name"
  done
}

cmd_halt() {
  prepare
  vagrant_cmd halt
}

cmd_destroy() {
  prepare
  local answer
  read -r -p "Destroy both lab VMs and all data? [y/N] " answer
  case "$answer" in
    y|Y) vagrant_cmd destroy -f ;;
    *) echo "Cancelled." ;;
  esac
}

cmd_reset() {
  prepare
  local answer
  read -r -p "Destroy and rebuild both lab VMs? [y/N] " answer
  case "$answer" in
    y|Y)
      vagrant_cmd destroy -f
      cmd_up
      ;;
    *) echo "Cancelled." ;;
  esac
}

cmd_check() {
  local module="${1:-}"
  local lab="${2:-all}"
  [ -n "$module" ] || die "usage: lab check <module> [lab1|lab2|challenge|all]"

  case "$lab" in
    lab1|lab2|challenge|all) ;;
    *) die "invalid lab '$lab' (use lab1, lab2, challenge, or all)" ;;
  esac

  local script="$LAB_DIR/checks/$module/check.sh"
  [ -f "$script" ] || die "no checker for module '$module' at $script"

  prepare
  info "Uploading checker for $module ($lab)"
  vagrant_cmd upload "$script" /tmp/rhcsa-check.sh server
  vagrant_cmd ssh server -c "sudo bash /tmp/rhcsa-check.sh $lab"
}

case "${1:-help}" in
  doctor)   cmd_doctor ;;
  up)       cmd_up ;;
  status)   cmd_status ;;
  ssh)      shift; cmd_ssh "$@" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  restore)  shift; cmd_restore "$@" ;;
  halt)     cmd_halt ;;
  destroy)  cmd_destroy ;;
  reset)    cmd_reset ;;
  check)    shift; cmd_check "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
