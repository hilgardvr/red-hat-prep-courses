# frozen_string_literal: true

# RHCSA Field Guide — lab environment
#
# Two disposable VMs:
#   server  10.10.10.10  2 vCPU / 4 GB / 20 GB root + 10 GB /dev/vdb
#   node2   10.10.10.11  1 vCPU / 2 GB / 20 GB root
#
# The lab runs AlmaLinux 10, a free RHEL 10-compatible rebuild that needs no
# subscription and installs its base packages from the box's own repositories.

require "pathname"

LAB_DIR = Pathname.new(__dir__)
KEY_PATH = Pathname.new(ENV.fetch("LAB_KEY_PATH", LAB_DIR.join("keys", "lab_ed25519").to_s))

unless KEY_PATH.file?
  abort <<~MSG
    Lab SSH key not found at #{KEY_PATH}

    Run ./bin/lab up from the labs/ directory. It generates the key on first
    use and passes it to both VMs.
  MSG
end

unless File.file?("#{KEY_PATH}.pub")
  abort "Public key not found: #{KEY_PATH}.pub"
end

Vagrant.configure("2") do |config|
  config.vm.box = "almalinux/10"
  config.vm.box_check_update = false
  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.ssh.keep_alive = true

  # A cold first boot on a loaded host can spend a couple of minutes in
  # NetworkManager-wait-online before sshd answers. Vagrant's 300 s default is
  # too close to that, and a timeout aborts the run before provisioning.
  config.vm.boot_timeout = 600

  config.vm.provider :libvirt do |lv|
    lv.driver = "kvm"
    lv.video_type = "virtio"
    lv.default_prefix = "rhcsa"

    # vagrant-libvirt 0.11.x defaults to the session connection when no URI is
    # set. Session mode cannot create the private lab network, so force the
    # system connection that `./bin/lab doctor` checks.
    lv.qemu_use_session = false

    # Newer libvirt/QEMU releases reject the host-model CPU block that
    # vagrant-libvirt generates on some hosts ("CPU vendor specified without
    # CPU model"), which makes an existing domain inaccessible to Vagrant.
    # host-passthrough exposes the host CPU without a vendor/model pair.
    lv.cpu_mode = "host-passthrough"
  end

  nodes = {
    "server" => { ip: "10.10.10.10", memory: 4096, cpus: 2, data_disk: "10G" },
    "node2"  => { ip: "10.10.10.11", memory: 2048, cpus: 1, data_disk: nil },
  }

  nodes.each do |name, opts|
    config.vm.define name do |node|
      node.vm.hostname = name

      # The private NIC is configured inside the guest by provision/common.sh.
      # Vagrant's own static-network configuration is unreliable on AlmaLinux
      # 10 with older Vagrant releases, so disable it and let NetworkManager
      # apply the address persistently.
      node.vm.network :private_network,
        ip: opts[:ip],
        auto_config: false,
        :libvirt__network_name => "rhcsa-lab",
        :libvirt__dhcp_enabled => false

      node.vm.provider :libvirt do |lv|
        lv.memory = opts[:memory]
        lv.cpus = opts[:cpus]
        lv.machine_virtual_size = 20

        if opts[:data_disk]
          lv.storage :file, :size => opts[:data_disk], :type => "qcow2", :bus => "virtio"
        end
      end

      # Upload provisioning helpers and the shared lab key.
      node.vm.provision "file", source: "provision/node2.sh", destination: "/tmp/node2.sh"
      node.vm.provision "file", source: KEY_PATH.to_s, destination: "/tmp/lab_key"
      node.vm.provision "file", source: "#{KEY_PATH}.pub", destination: "/tmp/lab_key.pub"

      node.vm.provision "shell",
        path: "provision/common.sh",
        args: [name, opts[:ip]]

      if name == "node2"
        node.vm.provision "shell", path: "provision/node2.sh"
      end
    end
  end
end
